<div class="container-fluid">
	<div class="d-flex flex-justify-between flex-align-center mb-4">
		<h4 class="m-0">{{ page_title }}</h4>
		<a href="{{ new_url }}" class="button primary"><span class="mif-plus"></span> {{ 'Создать'|trans }}</a>
	</div>
	<div class="remark info mb-4">
		<p class="m-0">{{ 'Пул HTTP/SOCKS-прокси для исходящих запросов к API соцсети.'|trans }}</p>
		<p class="m-0 mt-2 text-small">{{ 'Необязательны: включаются в шаблоне (use_proxy и опционально proxy_id). Без прокси шаблоны ходят напрямую.'|trans }}</p>
	</div>
	<table class="table striped table-border row-hover">
		<thead>
		<tr>
			<th>#</th>
			<th>{{ 'Адрес'|trans }}</th>
			<th>{{ 'Тип'|trans }}</th>
			<th>{{ 'Активно'|trans }}</th>
			<th></th>
		</tr>
		</thead>
		<tbody>
		{% for item in items %}
			<tr>
				<td>{{ item.id }}</td>
				<td><a href="{{ item.edit_url }}">{{ item.ip }}:{{ item.port }}</a></td>
				<td>{{ item.type }}</td>
				<td>{{ item.active ? 'Да'|trans : 'Нет'|trans }}</td>
				<td class="text-right">
					<div class="dropdown-button place-right">
						<button type="button" class="button small dropdown-toggle">{{ 'Действия'|trans }}</button>
						<ul class="d-menu drop-down-right" data-role="dropdown">
							<li><a href="{{ item.edit_url }}">{{ 'Редактировать'|trans }}</a></li>
							<li><a href="#" data-repost-copy="proxy" data-id="{{ item.id }}">{{ 'Копировать'|trans }}</a></li>
							<li>
								<a href="#" data-repost-toggle="proxy" data-id="{{ item.id }}" data-active="{{ item.active ? '1' : '0' }}">
									{{ item.active ? 'Отключить'|trans : 'Включить'|trans }}
								</a>
							</li>
							<li class="divider"></li>
							<li><a href="#" class="fg-red" data-repost-delete="proxy" data-id="{{ item.id }}">{{ 'Удалить'|trans }}</a></li>
						</ul>
					</div>
				</td>
			</tr>
		{% else %}
			<tr><td colspan="5">{{ 'Нет прокси'|trans }}</td></tr>
		{% endfor %}
		</tbody>
	</table>
</div>
